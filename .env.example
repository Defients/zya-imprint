# Frontend base path. Use /zya-imprint/ when the built dashboard is uploaded to that directory.
VITE_BASE_PATH=/zya-imprint/

# Browser runtime API behavior:
# - auto: probe /api/health, then use live server APIs when present
# - enabled: assume the configured API exists
# - disabled: static/cache-only build; performs no API probe
VITE_RUNTIME_API=auto

# Optional API origin or path prefix, e.g. https://analytics.example.com or /backend.
# Leave blank when the API shares the dashboard origin.
VITE_API_BASE_URL=

# CORS proxy prefix used for direct Neocities API calls when the runtime API is
# unreachable in `auto` mode. The target URL is appended (URL-encoded) to this.
# Defaults to corsproxy.io. No effect in `disabled` mode.
VITE_NEOCITIES_CORS_PROXY=https://corsproxy.io/?url=

# Optional Node collector. Disabled unless explicitly enabled.
IMPRINT_COLLECTOR_ENABLED=false

# Comma-separated exact origins or wildcard subdomains such as https://deffy.neocities.org,*.neocities.org
IMPRINT_ALLOWED_ORIGINS=https://deffy.neocities.org

# Required to read collector aggregates in production.
IMPRINT_READ_TOKEN=replace-with-a-long-random-token

# Remote daily aggregate retention (7–3650 days).
IMPRINT_RETENTION_DAYS=365

# Optional custom file location for aggregate collector data.
IMPRINT_DATA_FILE=./data/imprints.json

PORT=3000
